<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FlightDashboard.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:FlightDashboard.Views"
    xmlns:models="using:FlightDashboard.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="32,20,32,32" Spacing="20">
            <StackPanel Spacing="4">
                <TextBlock
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Airspace at a glance" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="A live pulse of aircraft moving through the central United States." />
            </StackPanel>

            <Border
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                Padding="28">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                    <StackPanel Spacing="12" VerticalAlignment="Center">
                        <TextBlock
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="REGIONAL AIRSPACE · HEARTLAND, USA" />
                        <TextBlock
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="Every aircraft tells a story." />
                        <TextBlock
                            MaxWidth="580"
                            Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="A 250 nautical mile snapshot centered near the geographic heart of the United States. Aircraft type appears when the feed provides it." />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Spacing="4"
                        VerticalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Right"
                            Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="AIRCRAFT IN VIEW" />
                        <TextBlock
                            AutomationProperties.AutomationId="TxtFlightCount"
                            HorizontalAlignment="Right"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Style="{StaticResource DisplayTextBlockStyle}"
                            Text="{x:Bind ViewModel.FlightCount, Mode=OneWay}" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            Foreground="{ThemeResource TextOnAccentFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.UpdatedLabel, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <InfoBar
                AutomationProperties.AutomationId="InfoFeedWarning"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasFeedWarning, Mode=OneWay}"
                Message="{x:Bind ViewModel.FeedWarningMessage, Mode=OneWay}"
                Severity="Warning"
                Title="{x:Bind ViewModel.FeedWarningTitle, Mode=OneWay}" />

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Padding="18">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="AIRBORNE" />
                        <TextBlock
                            AutomationProperties.AutomationId="TxtCruisingCount"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.CruisingCount, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="At 10,000 ft or above" />
                    </StackPanel>
                </Border>
                <Border
                    Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Padding="18">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="ON GROUND" />
                        <TextBlock
                            AutomationProperties.AutomationId="TxtGroundCount"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.GroundCount, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Reporting ground status" />
                    </StackPanel>
                </Border>
                <Border
                    Grid.Column="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Padding="18">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="CALLSIGN PREFIXES" />
                        <TextBlock
                            AutomationProperties.AutomationId="TxtOperatorCount"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.OperatorCount, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Distinct prefix groups" />
                    </StackPanel>
                </Border>
                <Border
                    Grid.Column="3"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Padding="18">
                    <StackPanel Spacing="8">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="TYPE IDENTIFIED" />
                        <TextBlock
                            AutomationProperties.AutomationId="TxtTypeCoverage"
                            Style="{StaticResource SubtitleTextBlockStyle}"
                            Text="{x:Bind ViewModel.TypeCoveragePercentLabel, Mode=OneWay}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.TypeCoverageLabel, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Padding="20">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="3">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Callsign prefix mix" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Prefixes are grouped as broadcast, not mapped to airline names." />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.OperatorBreakdown, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:DistributionItem">
                                    <Grid
                                        ColumnDefinitions="76,*"
                                        ColumnSpacing="12"
                                        Margin="0,4">
                                        <TextBlock
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Label, Mode=OneTime}" />
                                        <ProgressBar
                                            Grid.Column="1"
                                            Maximum="100"
                                            Value="{x:Bind Percentage, Mode=OneTime}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    Padding="20">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="3">
                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="Traffic by altitude" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Reported barometric altitude, grouped for this snapshot." />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.AltitudeBreakdown, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:DistributionItem">
                                    <Grid
                                        ColumnDefinitions="132,*"
                                        ColumnSpacing="12"
                                        Margin="0,4">
                                        <TextBlock
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Label, Mode=OneTime}" />
                                        <ProgressBar
                                            Grid.Column="1"
                                            Maximum="100"
                                            Value="{x:Bind Percentage, Mode=OneTime}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
