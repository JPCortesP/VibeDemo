<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="FlightDashboard.Views.FlightsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:models="using:FlightDashboard.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32,20,32,28" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="16">
        <StackPanel Spacing="4">
            <TextBlock
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Aircraft in range" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="Search callsigns, aircraft types, or registrations. Filter by current status." />
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            AutomationProperties.AutomationId="InfoFeedWarning"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasFeedWarning, Mode=OneWay}"
            Message="{x:Bind ViewModel.FeedWarningMessage, Mode=OneWay}"
            Severity="Warning"
            Title="{x:Bind ViewModel.FeedWarningTitle, Mode=OneWay}" />

        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="12">
            <AutoSuggestBox
                AutomationProperties.AutomationId="SearchFlights"
                AutomationProperties.Name="Search flights"
                PlaceholderText="Search callsign, type, or registration"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox
                Grid.Column="1"
                AutomationProperties.AutomationId="FilterFlightStatus"
                AutomationProperties.Name="Filter flights by status"
                SelectedValue="{x:Bind ViewModel.SelectedFilter, Mode=TwoWay}"
                SelectedValuePath="Content"
                Width="180">
                <ComboBoxItem Content="All traffic" />
                <ComboBoxItem Content="Cruising" />
                <ComboBoxItem Content="On ground" />
            </ComboBox>
        </Grid>

        <Grid Grid.Row="3" RowDefinitions="Auto,*" RowSpacing="8">
            <Grid
                Padding="12,0,12,8"
                ColumnDefinitions="*,140,120,100,110">
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="CALLSIGN / REGISTRATION" />
                <TextBlock
                    Grid.Column="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="AIRCRAFT TYPE" />
                <TextBlock
                    Grid.Column="2"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="ALTITUDE" />
                <TextBlock
                    Grid.Column="3"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="SPEED" />
                <TextBlock
                    Grid.Column="4"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="STATUS" />
            </Grid>

            <Grid Grid.Row="1">
                <ListView
                    x:Name="FlightList"
                    AutomationProperties.AutomationId="FlightList"
                    IsItemClickEnabled="False"
                    ItemsSource="{x:Bind ViewModel.FilteredFlights, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Flight">
                            <Grid
                                ColumnDefinitions="*,140,120,100,110"
                                Padding="12,10">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind DisplayCallsign, Mode=OneTime}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind DisplayRegistration, Mode=OneTime}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind DisplayType, Mode=OneTime}"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="2"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind AltitudeLabel, Mode=OneTime}"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="3"
                                    Style="{StaticResource BodyTextBlockStyle}"
                                    Text="{x:Bind SpeedLabel, Mode=OneTime}"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="4"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind StatusLabel, Mode=OneTime}"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <InfoBar
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.IsFilteredListEmpty, Mode=OneWay}"
                    Message="Try another search or status filter."
                    Severity="Informational"
                    Title="No matching flights" />
            </Grid>
        </Grid>
    </Grid>
</Page>
